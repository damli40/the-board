# Copy this file to `.env` and fill in what you need. Every variable here is optional for a plain
# `npm run demo` (the dev server has safe defaults for local use) — you only need any of this for
# Path B in RUNNING.md (driving a panel with a real model) or for a production deploy.
#
# IMPORTANT: this project's dev server reads these with plain Node `process.env`, not through a
# `.env`-loading library, so simply creating a `.env` file does NOT make these values reach the
# server on its own. Either export them in your shell before running `npm run demo`, or start the
# server with Node's own env-file flag instead: `node --env-file=.env scripts/dev-origins.mjs`.
# See RUNNING.md, Section 4.

# Shared password the model proxy requires on every request (header: x-room-code). Local dev
# already accepts the demo value 'board-demo-2026' even if this is left unset — see
# packages/panel/vite.config.ts. A public deployment MUST set its own, different value here: the
# demo value is committed to this public repository, so leaving it in place on a real deploy is the
# same as having no password at all.
ROOM_CODE=

# Your AI provider's API key. Kept on the server only, never sent to the browser. Without this
# (and without a key pasted into the panel's own "Connect the agents" setup form) every model call
# fails closed with a 503 ("no model key").
MODEL_API_KEY=

# Which provider MODEL_API_KEY belongs to. One of: anthropic, openai, google, openai-compatible.
# Defaults to anthropic if left unset.
MODEL_PROVIDER=

# Which model id to call. Defaults to each provider's own default model if left unset (currently
# claude-opus-5 for anthropic, gpt-5 for openai, gemini-3-pro for google; openai-compatible has no
# default and requires this).
MODEL_ID=

# Overrides the provider's default API base URL. Required for openai-compatible (which has no
# default of its own — point it at OpenRouter, Groq, a local Ollama server, etc.); otherwise only
# needed to redirect a first-party provider through your own Anthropic/OpenAI/Google-compatible
# gateway. Leave unset to use that provider's normal public endpoint.
MODEL_BASE_URL=

# Requests allowed per 60-second window, per running server process (not a global cap across every
# deployed copy). Defaults to 60 if left unset. The real spending limit belongs on the API key
# itself, at the provider's own console — see docs/evidence/deploy.md.
RATE_LIMIT=
